#!/bin/zsh

setup() {
  ZOTFILES="${0:a:h}"
  brew update
}

install_prefs() {
  # macOS's preferences daemon no longer follows symlinks in ~/Library/Preferences,
  # so point iTerm2 at this repo with its "load preferences from a custom folder" setting.
  local link="$HOME/Library/Preferences/com.googlecode.iterm2.plist"
  [ -L "$link" ] && rm "$link"
  defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$ZOTFILES"
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
}

install_omz() {
  if [ ! -d "$HOME/.ohmyzsh" ]; then
    git clone git@github.com:ohmyzsh/ohmyzsh.git ~/.ohmyzsh
  fi
  if [ "$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')" != "/bin/zsh" ]; then
    chsh -s /bin/zsh
  fi
}

install_powerline() {
  echo "Installing powerline fonts"
  pushd "$HOME/workspace"
    if [ ! -d "powerline-fonts" ]; then
      git clone git@github.com:powerline/fonts.git powerline-fonts
    fi
    # ~/Library/Fonts isn't created on new macOS accounts until something needs it
    mkdir -p "$HOME/Library/Fonts"
    pushd powerline-fonts
      ./install.sh
    popd
  popd
}

link_nvim() {
  echo "Linking neovim config"
  local target="$HOME/.config/nvim"
  mkdir -p "$HOME/.config"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    local backup="$target.bak-$(date +%Y%m%d%H%M%S)"
    echo "Moving existing $target to $backup"
    mv "$target" "$backup"
  fi
  ln -sfn "$ZOTFILES/nvim" "$target"
}

install_neovim_python() {
  echo "Setting up neovim Python support"
  local venv_dir="$HOME/.local/share/nvim/venv"
  if [ ! -d "$venv_dir" ]; then
    mkdir -p "$(dirname "$venv_dir")"
    /opt/homebrew/bin/python3 -m venv "$venv_dir"
  fi
  "$venv_dir/bin/pip" install --upgrade pip pynvim
}

link_dotfiles() {
  ln -sf "$ZOTFILES/.zshrc" "$HOME/.zshrc"
  ln -sf "$ZOTFILES/zagnoster.zsh-theme" "$HOME/.ohmyzsh/themes/zagnoster.zsh-theme"
  cp "$ZOTFILES/.gitconfig" "$HOME/.gitconfig"
}

set_defaults() {
  defaults write NSGlobalDomain KeyRepeat 1
  defaults write NSGlobalDomain InitialKeyRepeat 15
}

main() {
  setup

  brew bundle

  install_prefs
  install_powerline
  install_omz
  link_nvim
  install_neovim_python
  link_dotfiles

  set_defaults
}

main $@
